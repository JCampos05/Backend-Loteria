generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum RoomStatus {
  WAITING
  IN_PROGRESS
  FINISHED
}

enum GameStatus {
  IN_PROGRESS
  FINISHED
}

model Room {
  id        String     @id @default(uuid())
  code      String     @unique @db.VarChar(8)
  status    RoomStatus @default(WAITING)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  players Player[]
  games   Game[]

  @@map("rooms")
}

model Player {
  id        String   @id @default(uuid())
  roomId    String   @map("room_id")
  name      String   @db.VarChar(40)
  isHost    Boolean  @default(false) @map("is_host")
  connected Boolean  @default(true)
  socketId  String?  @map("socket_id")
  joinedAt  DateTime @default(now()) @map("joined_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  boards   PlayerBoard[]
  winClaims WinClaim[]
  gamesWon Game[]        @relation("GameWinner")

  @@index([roomId])
  @@map("players")
}

model Game {
  id        String     @id @default(uuid())
  roomId    String     @map("room_id")
  status    GameStatus @default(IN_PROGRESS)
  winnerId  String?    @map("winner_id")
  startedAt DateTime   @default(now()) @map("started_at")
  endedAt   DateTime?  @map("ended_at")

  room   Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  winner Player? @relation("GameWinner", fields: [winnerId], references: [id], onDelete: SetNull)

  boards      PlayerBoard[]
  calledCards CalledCard[]
  winClaims   WinClaim[]

  @@index([roomId])
  @@map("games")
}

model Card {
  id       Int    @id @default(autoincrement())
  name     String @unique @db.VarChar(40)
  imageUrl String @map("image_url")

  boards      BoardCard[]
  calledCards CalledCard[]

  @@map("cards")
}

model PlayerBoard {
  id       String @id @default(uuid())
  gameId   String @map("game_id")
  playerId String @map("player_id")

  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  cards BoardCard[]

  @@unique([gameId, playerId])
  @@map("player_boards")
}

model BoardCard {
  id            String  @id @default(uuid())
  playerBoardId String  @map("player_board_id")
  cardId        Int     @map("card_id")
  position      Int
  marked        Boolean @default(false)

  playerBoard PlayerBoard @relation(fields: [playerBoardId], references: [id], onDelete: Cascade)
  card        Card        @relation(fields: [cardId], references: [id])

  @@unique([playerBoardId, cardId])
  @@unique([playerBoardId, position])
  @@map("board_cards")
}

model CalledCard {
  id        String   @id @default(uuid())
  gameId    String   @map("game_id")
  cardId    Int      @map("card_id")
  callOrder Int      @map("call_order")
  calledAt  DateTime @default(now()) @map("called_at")

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id])

  @@unique([gameId, cardId])
  @@unique([gameId, callOrder])
  @@map("called_cards")
}

model WinClaim {
  id        String   @id @default(uuid())
  gameId    String   @map("game_id")
  playerId  String   @map("player_id")
  isValid   Boolean  @map("is_valid")
  reason    String?  @db.VarChar(255)
  claimedAt DateTime @default(now()) @map("claimed_at")

  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@map("win_claims")
}
